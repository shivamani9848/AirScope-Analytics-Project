# ==============================================================================
# AirScope Analytics - Root Environment Configuration Example
# ==============================================================================

# Database
MYSQL_ROOT_PASSWORD=replace_with_secure_root_password
MYSQL_DB=airq
MYSQL_USER=airscope
MYSQL_PASSWORD=replace_with_secure_user_password

# Backend Security
JWT_SECRET=replace_with_a_64_character_hex_or_base64_string
API_KEY=replace_with_production_api_key

# External Data Providers (Optional)
WAQI_TOKEN=your_waqi_api_token
OPENAQ_API_KEY=your_openaq_api_key
