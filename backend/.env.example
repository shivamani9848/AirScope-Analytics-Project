# ==============================================================================
# AirScope Analytics Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server & Security Settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_KEY=dev-key-123
DEFAULT_PLAN=free
JWT_SECRET=your-secure-random-jwt-secret-key-here
JWT_EXPIRES_MIN=60
COOKIE_DOMAIN=localhost

# MySQL Database Configuration
# You can provide DATABASE_URL directly or individual MYSQL_* components
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/airq?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=airq
MYSQL_USER=root
MYSQL_PASSWORD=

# Data Sources & Ingestion
SOURCES_ENABLED=open-meteo,openaq,iqair,waqi
WAQI_TOKEN=

# Data Aggregation & Outlier Filtering
AGG_WEIGHTS=open-meteo=1.0,openaq=1.0,iqair=0.8,waqi=0.8
AGG_TRIM=0
AGG_TRIM_METHOD=zscore
AGG_Z=3.0
AGG_IQR_K=1.5

# Ollama LLM Agent Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Report Styling
AIRSENSE_ACCENT_HEX=#22C55E
