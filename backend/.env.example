# ==============================================================================
# AirScope Analytics Backend Configuration Example
# Copy to .env and configure for your deployment environment.
# ==============================================================================

# Server & Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
API_KEY=replace-with-a-high-entropy-api-key
DEFAULT_PLAN=free
JWT_SECRET=replace-with-a-64-character-cryptographic-random-secret
JWT_EXPIRES_MIN=60
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database Configuration (supports MySQL 8.0 or SQLite)
# For SQLite (default for development/testing):
DATABASE_URL=sqlite:///./airq.db
# For MySQL 8.0 (production):
# DATABASE_URL=mysql+pymysql://airscope_user:change_this_password@mysql:3306/airq?charset=utf8mb4

# Environmental Data Ingestion Sources
SOURCES_ENABLED=open-meteo,openaq,iqair,waqi
WAQI_TOKEN=optional_waqi_api_token
OPENAQ_API_KEY=optional_openaq_api_key

# Aggregation Weights & Outlier Trimming
AGG_WEIGHTS=open-meteo=1.0,openaq=1.0,iqair=0.8,waqi=0.8
AGG_TRIM=0

# AI Agent & Ollama Integration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
